# Copy to .env and fill in. Anything VITE_* is embedded in the bundle and is
# PUBLIC — never put a secret key here.

# Backend base URL. Leave empty to run the app on local mocks (no real OTP,
# no real payments).
VITE_API_URL=

# Razorpay publishable key id — safe to ship. Get it from the Razorpay
# dashboard; rzp_test_* for testing, rzp_live_* when you go live.
VITE_RAZORPAY_KEY_ID=
