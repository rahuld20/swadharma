# Copy to .env and fill in. Anything VITE_* is embedded in the bundle and is
# PUBLIC — never put a secret key here.

# Backend base URL. This one variable chooses the data source for the whole
# app: set it and every repository in src/services calls your API; leave it
# empty and they read the in-memory mock in src/services/mock (no real OTP,
# no real payments).
#
# Nothing else has to change to switch. If your paths differ, edit
# src/services/endpoints.js; if your field names differ, edit the model's
# from() in src/models. See "Swapping the mock for a real API" in README.md.
VITE_API_URL=

# Razorpay publishable key id — safe to ship. Get it from the Razorpay
# dashboard; rzp_test_* for testing, rzp_live_* when you go live.
VITE_RAZORPAY_KEY_ID=
